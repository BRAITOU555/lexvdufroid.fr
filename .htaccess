Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Canonical domain: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.lexvdufroid\.fr$ [NC]
RewriteRule ^ https://lexvdufroid.fr%{REQUEST_URI} [R=301,L]

# Clean homepage URL
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Old Paris arrondissement URLs
Redirect 301 /zones/paris-1.html /zones/installation-climatisation-paris-1er.html
Redirect 301 /zones/paris-2.html /zones/installation-climatisation-paris-2e.html
Redirect 301 /zones/paris-3.html /zones/installation-climatisation-paris-3e.html
Redirect 301 /zones/paris-4.html /zones/installation-climatisation-paris-4e.html
Redirect 301 /zones/paris-5.html /zones/installation-climatisation-paris-5e.html
Redirect 301 /zones/installation-climatisation-paris-5.html /zones/installation-climatisation-paris-5e.html
Redirect 301 /zones/installation-climatisation-paris-6.html /zones/installation-climatisation-paris-6e.html
Redirect 301 /zones/installation-climatisation-paris-7.html /zones/installation-climatisation-paris-7e.html
Redirect 301 /zones/installation-climatisation-paris-8.html /zones/installation-climatisation-paris-8e.html
Redirect 301 /zones/installation-climatisation-paris-9.html /zones/installation-climatisation-paris-9e.html
Redirect 301 /zones/installation-climatisation-paris-10.html /zones/installation-climatisation-paris-10e.html

AddType image/avif .avif
AddType image/webp .webp

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml image/svg+xml
</IfModule>
